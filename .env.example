# Essay Reader 配置示例
# 复制为 .env 并按需修改，或直接在应用的「设置」面板中修改（会立即生效）。

# ---------------- 模型通道 ----------------
# local = 本地 Ollama（免费离线） | cloud = OpenAI 兼容云端（按 token 计费） | off = 纯阅读
LLM_PROVIDER=off

# ---------------- 本地通道（Ollama） ----------------
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# 8GB 显存建议 8B 级 + Q5/Q6 量化：宁可小模型高精度量化，也不要大模型激进量化
LOCAL_LLM_MODEL=qwen3:8b

# ---------------- 云端通道（OpenAI 兼容） ----------------
CLOUD_LLM_BASE_URL=https://api.deepseek.com/v1
CLOUD_LLM_MODEL=deepseek-chat
# 密钥只保存在本机后端，不会写入前端或仓库
CLOUD_LLM_API_KEY=

# ---------------- 并发与显存约束 ----------------
# 本地推理与 OCR 串行执行，并发保持 1 可避免显存 OOM
ESSAY_LOCAL_CONCURRENCY=1
ESSAY_CLOUD_CONCURRENCY=4
ESSAY_CHUNK_TOKEN_BUDGET=1200
ESSAY_CONTEXT_PARAGRAPHS=2
ESSAY_REQUEST_TIMEOUT_S=180
ESSAY_MAX_RETRIES=2
ESSAY_QUALITY_RETRY_LIMIT=1
# 单篇 token 预算上限，0 = 不限制（超出即停止并保留已翻译段落）
ESSAY_TOKEN_BUDGET_PER_DOC=0

# ---------------- 费用估算（人民币 / 百万 token） ----------------
CLOUD_PRICE_IN_PER_M=1.0
CLOUD_PRICE_OUT_PER_M=2.0

# ---------------- 解析 ----------------
ESSAY_RENDER_DPI=200
ESSAY_MAX_UPLOAD_MB=200
# 小于此面积占比的图片不视为插图（过滤 logo、横线、印章）
ESSAY_FIGURE_MIN_AREA_RATIO=0.012
ESSAY_COLUMN_MIN_GAP_RATIO=0.035

# ---------------- 扫描件 OCR（本地离线，RapidOCR/ONNX） ----------------
# auto = 仅对没有文本层的扫描页做 OCR | force = 所有页面都过 OCR | off = 关闭
ESSAY_OCR_MODE=auto
ESSAY_OCR_ENABLED=true
ESSAY_OCR_DPI=200
# OCR 跑在 CPU 上，线程数压低可避免与本地模型的推理争抢
ESSAY_OCR_THREADS=2
# 低于此置信度的识别结果直接丢弃
ESSAY_OCR_MIN_CONFIDENCE=0.5
# 页面字符数低于该值时视为扫描页候选
ESSAY_OCR_MIN_TEXT_CHARS=240

# ---------------- 数据目录（默认 backend/data） ----------------
# ESSAY_DATA_DIR=
